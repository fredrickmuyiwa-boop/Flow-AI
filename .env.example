# ---------------------------------------------------------------
# FlowPilot AI — environment variables (ALL OPTIONAL)
# The app runs fully without any of these. Copy to .env.local to use.
# ---------------------------------------------------------------

# Frontend (exposed to the browser — never put secrets in VITE_* vars)
# "local"  = deterministic in-browser intelligence (default, no API calls)
# "claude" = Copilot calls the secure /api/copilot serverless function
VITE_AI_MODE=local

# Server-side only (Vercel → Project → Settings → Environment Variables)
# Read exclusively by /api/copilot.js. Never shipped to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
